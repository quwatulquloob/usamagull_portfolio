{
  "name": "usama-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio site + admin panel on Cloudflare Workers with D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "seed": "node scripts/seed.mjs",
    "db:init:local": "wrangler d1 execute usama-portfolio-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute usama-portfolio-db --remote --file=./schema.sql",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "check:essentials": "node scripts/check-essentials.mjs",
    "check:layout": "node scripts/check-layout.cjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250914.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.42.0"
  },
  "dependencies": {
    "resend": "^6.30.0"
  }
}
