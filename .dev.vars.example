ADMIN_USERNAME=admin
# PBKDF2-SHA256 hash of the admin password (format: pbkdf2$iter$salt$hash).
# Generate with: npm run seed  (the plaintext is never stored anywhere)
ADMIN_PASSWORD_HASH=pbkdf2$100000$...$...
# HMAC-SHA256 secret used to sign admin session cookies. Generate a fresh
# random value for production (the seed script does this automatically):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-session-secret-replace-me
# Required for contact form notifications and automatic acknowledgments
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxx
# Sender using a domain verified with Resend. Acknowledgments go to the
# email address submitted in the inquiry form, not to NOTIFY_EMAIL.
CONTACT_FROM_EMAIL="Portfolio Contact <contact@yourdomain.com>"
# Optional email address for separate inquiry notifications
NOTIFY_EMAIL=your-email@example.com
